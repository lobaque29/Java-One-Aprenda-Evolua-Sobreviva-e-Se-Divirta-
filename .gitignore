# ==========================================
# Java / Spring Boot .gitignore
# ==========================================

# ------------------------------------------
# Arquivos do Build (Maven / Gradle)
# ------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!checkstyle.xml

build/
!.gradle/wrapper/gradle-wrapper.jar
bin/
out/
.gradle/
.settings/

# ------------------------------------------
# Logs e Arquivos Temporários
# ------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# Arquivos de Configuração / Bancos Locais
# ------------------------------------------
# Descomente se tiver senhas/chaves locais no application.properties ou application.yml
# src/main/resources/application-local.yml
# src/main/resources/application-dev.properties
*.db
*.sqlite

# ------------------------------------------
# IDE - IntelliJ IDEA
# ------------------------------------------
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# ------------------------------------------
# IDE - Eclipse
# ------------------------------------------
.metadata
.classpath
.project
.settings/
*.launch
*.factorypath

# ------------------------------------------
# IDE - VS Code
# ------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------
# Sistema Operacional
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSSharedFileList
.Spotlight-V100
.Trashes
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthru.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# Pacotes de Histórico / Executáveis gerados
# ------------------------------------------
*.jar
*.war
*.ear
*.rar
